{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap Desk",
  "version": "0.1.6-beta.2",
  "identifier": "io.snapdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Snap Desk",
        "width": 1100,
        "height": 680,
        "minWidth": 780,
        "minHeight": 660,
        "center": true
      },
      {
        "label": "capture",
        "create": false,
        "title": "Snap Desk Capture",
        "transparent": true,
        "url": "index.html?window=capture",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "recording-controls",
        "create": false,
        "transparent": true,
        "title": "录屏控制",
        "url": "index.html?window=recording-controls",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "contentProtected": true,
        "width": 480,
        "height": 48
      },
      {
        "label": "scroll-preview",
        "create": false,
        "title": "长截图实时预览",
        "url": "index.html?window=scroll-preview",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "width": 220,
        "height": 420
      },
      {
        "label": "scroll-controls",
        "create": false,
        "title": "长截图操作",
        "url": "index.html?window=scroll-controls",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "width": 320,
        "height": 48
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: capture-image: http://capture-image.localhost recording: http://recording.localhost; media-src 'self' recording: http://recording.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: capture-image: http://capture-image.localhost recording: http://recording.localhost; media-src 'self' recording: http://recording.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../LICENSE": "LICENSE",
      "licenses/LXGW-OFL.txt": "licenses/LXGW-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
