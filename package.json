{
  "name": "snap-desk",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/bitdan/snap-desk.git" },
  "version": "0.1.7-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "check": "vue-tsc --noEmit",
    "test": "vitest run && node --test scripts/sync-version.test.mjs",
    "tauri": "tauri",
    "version:sync": "node scripts/sync-version.mjs",
    "predesktop:dev": "npm run version:sync",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs --no-bundle --ci -- --locked",
    "desktop:build:fast": "node scripts/build-desktop.mjs --no-bundle --ci --debug -- --locked",
    "desktop:package": "node scripts/build-desktop.mjs --ci -- --locked",
    "desktop:clean": "node scripts/clean-desktop.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.468.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.6.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
